{
  "expo": {
    "name": "AttendIQ",
    "slug": "attendiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.attendiq.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AttendIQ requires campus GPS location to verify student attendance.",
        "NSPhotoLibraryUsageDescription": "AttendIQ requires document and photo access to verify course selection slips and teacher ID cards."
      }
    },
    "android": {
      "package": "com.attendiq.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      }
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#ffffff",
      "translucent": true
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "d6cfd4ed-8dd4-4d1f-94d1-d3ee146d4c79"
      }
    },
    "owner": "ggvattendences-team"
  }
}
