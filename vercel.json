{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://mark-attendance-backend.onrender.com/api/$1"
    },
    {
      "source": "/((?!_expo|assets|favicon\\.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
